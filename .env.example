# Copy to .env and adjust. Never commit real secrets.

# --- Datastores (match infra/docker-compose.yml) ---
DATABASE_URL=postgres://civa:civa@localhost:5432/civa
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=dev-only-change-me
JWT_ISSUER=civa
ACCESS_TOKEN_TTL=900            # seconds
REFRESH_TOKEN_TTL=2592000       # seconds (30d)

# --- LiveKit (dev defaults from docker-compose) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- TTS gateway / ml-box worker contract ---
# The local Silero worker (D:\dev\leaders\ml-box) authenticates with this bearer token.
ML_BOX_TOKEN=dev-tts-token
TTS_STORE_DIR=./infra/tts-store

# --- Ports (defaults; each service reads its own) ---
GATEWAY_PORT=8080
AUTH_PORT=8081
LOBBY_PORT=8082
ENGINE_PORT=8083
TRADE_PORT=8084
DIPLOMACY_PORT=8085
ASSEMBLY_PORT=8086
TTS_GATEWAY_PORT=8087

# --- Platform services (services/*, this repo) ---
# AUTH_PORT is shared with the block above. social/chat/community aren't game-domain services
# (no port collision — the block above is CIVA's own game-domain ports, a different process tree).
SOCIAL_PORT=8083
CHAT_PORT=8084
COMMUNITY_PORT=8085
# Account ids allowed to publish a changelog entry (comma-separated). Empty = no one can; reads
# still work. Discussion threads/posts need no allowlist — any logged-in account may post.
COMMUNITY_ADMIN_IDS=
# The hub (apps/hub) and any game consuming the SDK from source read these via Vite; unset in dev
# defaults each to its own localhost port (see packages/sdk/src/config.ts).
VITE_AUTH_URL=http://localhost:8081
VITE_SOCIAL_URL=http://localhost:8083
VITE_CHAT_URL=http://localhost:8084
VITE_COMMUNITY_URL=http://localhost:8085
