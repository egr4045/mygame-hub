{
  "name": "mygame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "mygame — game platform hub: shared auth, friends/social, game launcher and the @mygame/sdk",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules/.cache .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "gen:service": "node scripts/gen-service.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "dev:auth": "pnpm --filter @mygame/auth dev",
    "dev:social": "pnpm --filter @mygame/social dev",
    "dev:chat": "pnpm --filter @mygame/chat dev",
    "dev:community": "pnpm --filter @mygame/community dev",
    "dev:orchestrator": "pnpm --filter @mygame/orchestrator dev",
    "dev:back": "turbo run dev --filter=@mygame/auth --filter=@mygame/social --filter=@mygame/chat --filter=@mygame/community --filter=@mygame/orchestrator",
    "dev:example": "pnpm --filter @mygame/example-game dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
