# Copy to .env and set a long random secret (used to sign + verify JWTs).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated platform accountIds allowed to publish a changelog entry (services/community).
# Leave empty at first boot; reads still work. Log in once, note your accountId (e.g. from the
# /auth/login response), then set it here and `docker compose up -d community` to apply.
COMMUNITY_ADMIN_IDS=

# The platform's public URL, baked into apps/example-game's bundle at BUILD time (Vite can't read
# env at container runtime) — its bundle talks to this directly for auth/social/chat/community,
# since it runs on its own origin/port like every other game. Rebuild+recreate
# (`docker compose up -d --build examplegame`) if this ever changes.
GAMEHUB_PUBLIC_URL=https://mygame-quiz.ru
