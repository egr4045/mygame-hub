# Copy to .env and set a long random secret (used to sign + verify JWTs).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated platform accountIds allowed to publish a changelog entry (services/community).
# Leave empty at first boot; reads still work. Log in once, note your accountId (e.g. from the
# /auth/login response), then set it here and `docker compose up -d community` to apply.
COMMUNITY_ADMIN_IDS=

# GAMEHUB's own self-hosted LiveKit (chat voice/video calls) — a separate instance from Leaders' own
# LiveKit on this server; never reuse Leaders' keys/ports. LIVEKIT_URL is the PUBLIC address the
# browser connects to (proxied through Caddy's /gamehub-livekit/* — see deploy/gamehub/Caddyfile),
# not an internal docker-network address. LIVEKIT_KEYS is "apikey: apisecret" (the space after the
# colon matters) — generate the secret with `openssl rand -hex 32`, never devkey/secret here (that's
# the local-dev-only default in infra/docker-compose.yml). Keep LIVEKIT_API_KEY/SECRET below in sync
# with whatever you put in LIVEKIT_KEYS.
LIVEKIT_URL=wss://mygame-quiz.ru/gamehub-livekit
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
LIVEKIT_KEYS=change-me: change-me-to-a-long-random-string
