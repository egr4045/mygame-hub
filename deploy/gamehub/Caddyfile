# GAMEHUB gateway (launcher origin), inside the `web` container on :8088. One origin fronts the SPA,
# auth, social, chat, community, the orchestrator, the on-demand game lobby, and any path-routed
# game (e.g. /example-game/*) — all reached over `gamehub-net`.
{
	admin off
	auto_https off
}

:8088 {
	encode gzip

	# Shared auth (client calls /auth/login on the same origin).
	handle /auth/* {
		reverse_proxy auth:8081
	}

	# Friends/presence (Socket.io, custom path — see services/social/src/server.ts for why it isn't
	# the default /socket.io/).
	handle /social.io/* {
		reverse_proxy social:8083
	}

	# DMs/groups (Socket.io, custom path — see services/chat/src/server.ts).
	handle /chat.io/* {
		reverse_proxy chat:8084
	}

	# Mint a LiveKit call token (plain HTTP, same chat container — see services/chat/src/server.ts).
	handle /chat/call/token {
		reverse_proxy chat:8084
	}

	# Chat image attachments: POST /chat/upload (auth'd, participant-checked) and the public
	# capability-URL GET /chat/media/<uuid>.<ext>. Without these two routes both fall through to the
	# SPA static handler below and uploads/image serving silently break in prod.
	handle /chat/upload* {
		reverse_proxy chat:8084
	}
	handle /chat/media/* {
		reverse_proxy chat:8084
	}

	# Changelog + discussions (HTTP).
	handle /community/* {
		reverse_proxy community:8085
	}

	# Orchestrator API: /orchestrator/games, /orchestrator/games/:id/enter (prefix stripped).
	handle_path /orchestrator/* {
		reverse_proxy orchestrator:8090
	}

	# LiveKit signaling (WebSocket) for chat voice/video calls — proxying works here because this is
	# just the signaling handshake (HTTP upgrade), not the actual RTC media (that's UDP/TCP, can't go
	# through Caddy — see docker-compose.yml's `livekit` service for those ports). Deliberately NOT
	# named /livekit/* — Leaders' own Caddy (a different, do-not-touch product on this shared server)
	# already claims that exact path for its own LiveKit instance; colliding with it would break
	# Leaders, not just this feature.
	handle_path /gamehub-livekit/* {
		reverse_proxy livekit:7880
	}

	# SDK starter template, path-routed rather than its own port — same origin as the hub, so a
	# browser's http→https auto-upgrade can't break the navigation (unlike an externalPort game).
	# Prefix stripped: Vite's base path (VITE_BASE_PATH, Dockerfile) generates asset URLs that
	# already include /example-game/, so the internal server sees the same paths it would at "/".
	handle_path /example-game/* {
		reverse_proxy examplegame:5190
	}

	# Minimal admin panel, same path-routing reasoning as /example-game/* above. Its own login gate +
	# server-side isAdmin check (not this route) is what actually protects it.
	handle_path /admin/* {
		reverse_proxy admin:5200
	}

	# Spellforge (cards) game socket — Socket.io on its own path, same escape hatch as
	# /social.io/ и /chat.io/: the default /socket.io/ below belongs to CIVA's lobby. The game's
	# stack is on-demand — 502s until the orchestrator brings it up.
	handle /cards-io/* {
		reverse_proxy cards-server:8091
	}

	# Spellforge SPA, path-routed like /example-game/* (prefix stripped; the game's build bakes
	# VITE_BASE_PATH=/cards/ — see the cards repo, deploy/build-images.sh).
	handle_path /cards/* {
		reverse_proxy cards-web:5210
	}

	# Своя игра (Svoyak): its SPA + own socket.io + API on one server. Path-routed like /cards/* and
	# /example-game/* — the prefix is STRIPPED, and the game's build bakes VITE_BASE_PATH=/svoyak/, so
	# its assets, socket.io and API all live under /svoyak/ and reach svoyak:8089 at root. Served over
	# the hub's HTTPS origin so getUserMedia (mic/cam) has a secure context (the whole point of this
	# route — plain http://:8089 blocks it). On-demand: 502s until the orchestrator wakes svoyak.
	handle_path /svoyak/* {
		reverse_proxy svoyak:8089
	}

	# Game lobby (Socket.io, default path). Started on demand — 502s until the orchestrator brings
	# it up. Does not collide with /social.io/ or /chat.io/ above.
	handle /socket.io/* {
		reverse_proxy lobby:8082
	}

	# SPA static with history fallback.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
